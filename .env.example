# Application
APP_NAME="Intelligent Document Q&A Assistant"
APP_VERSION="1.0.0"
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb

# LLM API (Groq or any OpenAI-compatible provider)
# Get a free Groq key at https://console.groq.com
NVIDIA_API_KEY=your_groq_api_key_here
NVIDIA_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512

# Embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval
RETRIEVAL_TOP_K=5

# Storage
FAISS_INDEX_PATH=faiss_index
UPLOAD_DIR=uploads

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=rag-document-qa
